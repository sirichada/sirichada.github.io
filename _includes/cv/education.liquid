{% comment %}
  Unified education entry renderer for both RenderCV and JSONResume formats
  Handles both:
  - RenderCV: institution, area, studyType (or degree), start_date, end_date, location, courses, highlights
  - JSONResume: institution, area, studyType, startDate, endDate, location, courses, highlights
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-3 col-sm-3 col-md-3 date-column">
          {% capture start_date_raw %}
            {% if entry.start_date %}{{ entry.start_date }}{% elsif entry.startDate %}{{ entry.startDate }}{% endif %}
          {% endcapture %}
          {% capture end_date_raw %}
            {% if entry.end_date %}{{ entry.end_date }}{% elsif entry.endDate %}{{ entry.endDate }}{% endif %}
          {% endcapture %}
          {% assign start_date = start_date_raw | strip %}
          {% assign end_date = end_date_raw | strip %}

          {% if start_date != '' %}
            {% comment %} Show "Mon YYYY" when a month is present (e.g. "2025-08"), else just the year (e.g. "1933") {% endcomment %}
            {% assign start_parts = start_date | split: '-' %}
            {% if start_parts.size > 1 %}
              {% assign startDate = start_date | append: '-01' | date: '%b %Y' %}
            {% else %}
              {% assign startDate = start_date %}
            {% endif %}

            {% if end_date == '' or end_date == nil or end_date == 'present' %}
              {% assign endDate = 'Present' %}
            {% else %}
              {% assign end_parts = end_date | split: '-' %}
              {% if end_parts.size > 1 %}
                {% assign endDate = end_date | append: '-01' | date: '%b %Y' %}
              {% else %}
                {% assign endDate = end_date %}
              {% endif %}
            {% endif %}

            {% assign date = startDate | append: ' - ' | append: endDate %}
          {% else %}
            {% assign date = null %}
          {% endif %}

          <table class="table-cv">
            <tbody>
              <tr>
                <td>
                  {% if date %}
                    <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">{{ date }}</span>
                  {% endif %}
                </td>
              </tr>
              {% capture location %}
                {% if entry.location %}{{ entry.location }}{% endif %}
              {% endcapture %}
              {% if location != '' %}
                <tr>
                  <td>
                    <p class="location">
                      <i class="fa-solid fa-location-dot iconlocation"></i>
                      {{ location }}
                    </p>
                  </td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="col-xs-9 col-sm-9 col-md-9 mt-2 mt-md-0">
          {% capture study_type %}
            {% if entry.studyType %}{{ entry.studyType }}{% elsif entry.degree %}{{ entry.degree }}{% endif %}
          {% endcapture %}

          {% if entry.url and entry.url != '' %}
            <h6 class="title font-weight-bold ml-1 ml-md-4">
              <a href="{{ entry.url }}">{{ study_type }}</a>
            </h6>
          {% elsif study_type != '' %}
            <h6 class="title font-weight-bold ml-1 ml-md-4">{{ study_type }}</h6>
          {% endif %}

          {% if entry.institution %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ entry.institution }}</h6>
          {% endif %}

          {% if entry.area %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ entry.area }}</h6>
          {% endif %}

          {% if entry.courses.size > 0 or entry.highlights.size > 0 %}
            <ul class="items">
              {% for item in entry.courses %}
                <li>
                  <span class="item">{{ item }}</span>
                </li>
              {% endfor %}
              {% for item in entry.highlights %}
                <li>
                  <span class="item">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
